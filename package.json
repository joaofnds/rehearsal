{
	"name": "rehearsal",
	"private": true,
	"bin": {
		"rehearsal": "./rehearsal.ts"
	},
	"type": "module",
	"imports": {
		"#benchmark/*": "./src/benchmark/*.ts",
		"#cli/*": "./src/cli/*.ts",
		"#ui/*": "./src/ui/*.ts"
	},
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --type-aware",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"rehearsal": "bun run rehearsal.ts",
		"ui": "bun run src/ui/main.ts"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.80.0",
		"@types/bun": "^1.4.0",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.0"
}
